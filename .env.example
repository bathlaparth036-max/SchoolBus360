# ==============================================================================
# SCHOOLBUS360 — ROOT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Never commit actual .env files or service account keys into Git.
# - Copy this file to .env or child module configs as needed.
# ==============================================================================

# FIREBASE PROJECT SETTINGS
FIREBASE_PROJECT_ID=schoolbus360-prod
FIREBASE_REGION=asia-south1

# ADMIN WEB APP (REACT + VITE)
# Prefix with VITE_ to expose to frontend code in admin/
VITE_FIREBASE_API_KEY=AIzaSyExampleFakeApiKeyForSchoolBus360
VITE_FIREBASE_AUTH_DOMAIN=schoolbus360-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=schoolbus360-prod
VITE_FIREBASE_STORAGE_BUCKET=schoolbus360-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# CLOUD FUNCTIONS SETTINGS
FUNCTIONS_EMULATOR_PORT=5001
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099

# MOBILE (FLUTTER) NOTE:
# Flutter Firebase configuration is typically provided via:
# - Android: mobile/android/app/google-services.json
# - iOS: mobile/ios/Runner/GoogleService-Info.plist
# - Generated via 'flutterfire configure'
